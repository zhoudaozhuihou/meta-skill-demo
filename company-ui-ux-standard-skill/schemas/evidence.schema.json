{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rules",
    "conflicts",
    "recommendations"
  ],
  "properties": {
    "repository": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "rules": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "recommendations": {
      "type": "array"
    }
  }
}
