{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WikiSkill Wiki Update",
  "type": "object",
  "required": [
    "create_patterns",
    "update_patterns",
    "update_index",
    "append_log"
  ],
  "properties": {
    "create_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "content"
        ]
      }
    },
    "update_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "edits"
        ]
      }
    },
    "update_index": {
      "type": "string"
    },
    "append_log": {
      "type": "string"
    }
  }
}
